# TrustPay Backend — environment template
# Copy to .env and fill in real values. Never commit a filled-in .env.

APP_NAME=TrustPay
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# PostgreSQL 16 running in WSL2 Docker (container: trustpay-postgres)
DATABASE_URL=postgresql+psycopg://trustpay:CHANGE_ME@localhost:5432/trustpay
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generated with secrets.token_urlsafe(64). Rotate per environment.
SECRET_KEY=replace_me_run__python_-c_"import secrets;print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Account protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# Financial simulation — TrustPay is NOT a bank or a licensed payment institution.
DEMO_MODE=true
DEFAULT_CURRENCY=INR

# ---------- AI ----------
# Leave blank to run the deterministic analysers instead. Every AI
# response reports which engine produced it.
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5
AI_EFFORT=high

CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:8081

# ---------- Google Sign-In ----------
# Create both at https://console.cloud.google.com/apis/credentials
# The Android client must be registered against package com.trustpay.app and
# the SHA-1 of the keystore the APK is signed with. See docs/GOING-LIVE.md.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---------- Payments ----------
# Real money needs a payment aggregator account with business KYC. Without
# these the payment endpoints refuse rather than simulate.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Mandatory for money to ever be credited: the webhook is the only path that
# does it, and an unsigned webhook is rejected.
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX virtual account, required for withdrawals and account verification.
RAZORPAY_PAYOUT_ACCOUNT=
MERCHANT_VPA=
MERCHANT_NAME=TrustPay
