# TrustPay Backend — environment template
# Copy to .env and fill in real values. Never commit a filled-in .env.

APP_NAME=TrustPay
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# PostgreSQL 16 running in WSL2 Docker (container: trustpay-postgres)
DATABASE_URL=postgresql+psycopg://trustpay:CHANGE_ME@localhost:5432/trustpay
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generated with secrets.token_urlsafe(64). Rotate per environment.
SECRET_KEY=replace_me_run__python_-c_"import secrets;print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Account protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# Financial simulation — TrustPay is NOT a bank or a licensed payment institution.
DEMO_MODE=true
DEFAULT_CURRENCY=INR

CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:8081
